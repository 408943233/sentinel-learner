{
  "name": "sentinel-learner",
  "version": "1.0.0",
  "description": "Sentinel Browser 录制任务的学习与分析系统",
  "main": "src/node/index.js",
  "scripts": {
    "start": "node src/node/index.js",
    "dev": "nodemon src/node/index.js",
    "learn": "node src/node/cli.js learn",
    "mock": "node src/node/cli.js mock",
    "evaluate": "node src/node/cli.js evaluate",
    "example:learn": "node src/node/cli.js learn --task=examples/task_sample",
    "test": "jest",
    "test:python": "cd src/python && python -m pytest",
    "setup:python": "cd src/python && pip install -r requirements.txt"
  },
  "keywords": [
    "sentinel",
    "browser",
    "learning",
    "automation",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "body-parser": "^1.20.5",
    "chalk": "^4.1.2",
    "cheerio": "^1.2.0",
    "commander": "^11.1.0",
    "cors": "^2.8.6",
    "express": "^4.22.1",
    "fs-extra": "^11.3.4",
    "glob": "^10.4.5",
    "http-proxy-middleware": "^4.0.0",
    "jsdom": "^29.1.1",
    "lodash": "^4.18.1",
    "mime-types": "^2.1.35",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.1",
    "ora": "^5.4.1",
    "playwright": "^1.59.1",
    "puppeteer": "^21.11.0",
    "uuid": "^9.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
