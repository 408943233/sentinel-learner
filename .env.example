# Sentinel Learner 环境变量配置示例
# 复制此文件为 .env 并修改为你的实际路径

# ============================================
# 必需配置
# ============================================

# OpenClaw Memory Skill 路径
# 指向 openclaw-memory-skill 的安装目录
OPENCLAW_MEMORY_PATH=/Users/gaoyiwei/Documents/trae_projects/openclaw/openclaw-memory-skill

# Image Stitch Skill 路径
# 指向 image-stitch skill 的 stitch.py 脚本
IMAGE_STITCH_SKILL_PATH=/Users/gaoyiwei/Documents/trae_projects/openclaw/.trae/skills/image-stitch/stitch.py

# ============================================
# 可选配置
# ============================================

# 默认 Task 路径
# 当不指定 task 路径时使用的默认值
SENTINEL_TASK_PATH=/Users/gaoyiwei/Documents/trae_projects/openclaw/output/collections/task_11_www.chinastock.com.cn_1778034751731

# Workspace 基础路径
# 用于存储知识图谱数据
SENTINEL_WORKSPACE=/Users/gaoyiwei/.openclaw/workspace

# OpenClaw Skill 路径（用于 unified_memory_adapter）
# 指向 openclaw-memory-skill 目录
OPENCLAW_SKILL_PATH=/Users/gaoyiwei/.openclaw/extensions/openclaw-memory-skill

# ============================================
# 服务器模式配置（可选）
# ============================================

# 运行模式: local 或 server
BUSINESS_LEARNER_MODE=local

# 服务器主机和端口（server 模式）
BUSINESS_LEARNER_HOST=0.0.0.0
BUSINESS_LEARNER_PORT=8000

# 任务存储路径（server 模式）
TASK_STORAGE_PATH=/data/tasks

# 日志配置
LOG_LEVEL=INFO
LOG_PATH=/var/log/business-learner
