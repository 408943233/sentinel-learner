# API配置
KIMI_CODING_API_KEY=sk-kimi-zhML5ZaA3RUhBw6TWawtWNQdod4Qf02Mokm4QzbXdSbden99YI4nyk5DE9GUJHJA
KIMI_CODING_BASE_URL=https://api.kimi.com/coding/
KIMI_CODING_MODEL=k2p5

# API超时和重试配置
API_TIMEOUT=120
API_MAX_RETRIES=5
API_RETRY_DELAY=1.0
API_MAX_RETRY_DELAY=60.0

# OCR配置
OCR_USE_GPU=false
OCR_LANG=ch
OCR_DET_DB_THRESH=0.1
OCR_DET_DB_BOX_THRESH=0.3
OCR_DROP_SCORE=0.2
OCR_MAX_BATCH_SIZE=1024
OCR_ENABLE_CACHE=true
OCR_CACHE_SIZE=100

# 图像处理配置
MAX_IMAGE_SIZE=4096
LOGICAL_WIDTH=390
LOGICAL_HEIGHT=844

# 输出配置
OUTPUT_DIR=./output
SAVE_DEBUG_INFO=true

# 性能监控
ENABLE_MONITORING=true
